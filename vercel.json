{
  "functions": {
    "api/checkout.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/verify.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/webhook.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/canva-callback.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/cal-webhook.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/polotab-token.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/canva-callback",
      "destination": "/api/canva-callback"
    },
    {
      "source": "/membership",
      "destination": "/membership.html"
    },
    {
      "source": "/menu",
      "destination": "/menu.html"
    },
    {
      "source": "/reservations",
      "destination": "/reservations.html"
    },
    {
      "source": "/hiring",
      "destination": "/hiring.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/checkin",
      "destination": "/checkin.html"
    },
    {
      "source": "/member",
      "destination": "/member.html"
    },
    {
      "source": "/gerente",
      "destination": "/gerente.html"
    },
    {
      "source": "/success",
      "destination": "/success.html"
    }
  ],
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "canica.fun"
        }
      ],
      "destination": "https://www.canica.fun/$1",
      "permanent": true
    }
  ]
}